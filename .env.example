# Backend environment variables. Copy to .env locally or set these in your hosting provider.

# Shared infrastructure
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_REPOSITORY_LOCATION=file:../config-repository
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka
EUREKA_HOSTNAME=localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Shared database credentials
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Optional per-service database overrides
USERSERVICE_DB_URL=jdbc:mysql://your-db-host:3306/userservicetrain?createDatabaseIfNotExist=true
TRAINSERVICE_DB_URL=jdbc:mysql://your-db-host:3306/trainservicetrain?createDatabaseIfNotExist=true
RESERVATIONSERVICE_DB_URL=jdbc:mysql://your-db-host:3306/reservationservicetrain?createDatabaseIfNotExist=true
PAYMENTSERVICE_DB_URL=jdbc:mysql://your-db-host:3306/paymentservicetrain?createDatabaseIfNotExist=true

# Payments
STRIPE_SECRET_KEY=your_stripe_secret_key
PAYMENT_GATEWAY=mock
PAYMENT_SUCCESS_URL=https://your-frontend-domain/payment-success
PAYMENT_CANCEL_URL=https://your-frontend-domain/dashboard

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_SMTP_SSL_TRUST=smtp.gmail.com
MAIL_TEST_CONNECTION=true
